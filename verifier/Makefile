# Verifier targets. Run from the repository root with `make -C verifier <target>`.
ROOT := ..

.PHONY: test test-short vet abi record-pcs build image

# Unit and integration tests. The anvil-based tests need anvil and forge on PATH and the contracts sources
# (<repo>/contracts, or SEALED_CONTRACTS_DIR); they skip otherwise.
test:
	cd $(ROOT) && go test ./verifier/...

# Unit tests only (no local chain).
test-short:
	cd $(ROOT) && go test -short ./verifier/...

vet:
	cd $(ROOT) && go vet ./verifier/...

# Refresh verifier/chain/abi from contracts/abi (generated by `make -C contracts abi`).
abi:
	cd $(ROOT) && go generate ./verifier/chain

# Re-record Intel PCS collateral for the quote fixtures (needs network access; changes testdata).
record-pcs:
	cd $(ROOT) && for q in v4_spr_e4 v5_sample v4_gce_cos113; do \
		go run ./verifier/internal/tools/pcsrecord -out verifier/attest/testdata/pcs/$$q verifier/attest/testdata/quotes/$$q.dat; \
	done

build:
	cd $(ROOT) && go build -o bin/sealed-verifierd ./verifier/cmd/sealed-verifierd

image:
	cd $(ROOT) && docker build -f verifier/Dockerfile -t sealed-verifierd .
