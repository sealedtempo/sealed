{
  "name": "@sealed/agent",
  "version": "0.1.0",
  "description": "sealed-agent: key release, disk unlock, secrets, evidence, attestation, metering and fee payments inside a Sealed confidential VM",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "sealed-agent": "dist/main.js",
    "sealed-dstack-sim": "dist/sim.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "sim": "node dist/sim.js"
  },
  "dependencies": {
    "@sealed/core": "workspace:*",
    "viem": "2.57.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
