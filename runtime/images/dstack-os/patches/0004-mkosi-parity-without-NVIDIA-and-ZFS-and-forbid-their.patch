From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sealedtempo <349375820+sealedtempo@users.noreply.github.com>
Date: Wed, 28 Oct 2026 00:00:00 +0000
Subject: [PATCH 4/7] mkosi: parity without NVIDIA and ZFS, and forbid their
 paths

check-parity.py runs in mkosi.finalize on every build. Remove the NVIDIA,
nvidia-container, nvattest and ZFS entries it required, empty the
ldconfig and runtime-linkage lists that only named NVIDIA libraries and
the zfs binary, and add the main NVIDIA and ZFS paths to
prod_forbidden_paths, so a build that ever reintroduces them fails before
assembly.
---
 os/mkosi/parity.json | 72 +++++++-------------------------------------
 1 file changed, 11 insertions(+), 61 deletions(-)

diff --git a/os/mkosi/parity.json b/os/mkosi/parity.json
index 2b2a627..257b218 100644
--- a/os/mkosi/parity.json
+++ b/os/mkosi/parity.json
@@ -28,38 +28,6 @@
       "etc/sysctl.d/99-sysbox-sysctl.conf",
       "etc/modules-load.d/50-sysbox-mod.conf"
     ],
-    "zfs-2.4.0": [
-      "usr/sbin/zfs",
-      "usr/sbin/zpool",
-      "usr/lib/systemd/system/zfs.target",
-      "usr/libexec/zfs/zed.d"
-    ],
-    "nvidia-595.91.07": [
-      "usr/bin/nvidia-smi",
-      "usr/bin/nvidia-persistenced",
-      "usr/bin/nv-fabricmanager",
-      "usr/lib/systemd/system/nvidia-fabricmanager.service",
-      "usr/bin/nvidia-gpu-detect",
-      "usr/bin/nvidia-module-options",
-      "usr/lib/systemd/system/nvidia-module-options.service",
-      "usr/lib/modprobe.d/nvidia-blacklist.conf",
-      "usr/lib/x86_64-linux-gnu/libnvidia-nscq.so.2",
-      "usr/lib/systemd/system/nvidia-fabricmanager.service.d/10-nvswitch-condition.conf"
