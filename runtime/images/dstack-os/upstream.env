# SPDX-License-Identifier: Apache-2.0
# Pinned inputs of the Sealed dstack OS image (D-015, D-016). Read by build.sh
# and .github/workflows/os-image.yml. Plain KEY=value lines only.

# Upstream dstack (Apache-2.0). The tag is informational; the commit is what is
# fetched and verified.
UPSTREAM_REPO=https://github.com/Dstack-TEE/dstack.git
UPSTREAM_TAG=v0.6.1
UPSTREAM_COMMIT=7f143148cc49f4a09799958835d310e050137cb3
# Upstream's own guest OS release of the same commit, for comparison only.
UPSTREAM_OS_RELEASE=mkosi-os-v0.6.1

# Sealed image version: <upstream dstack version>-s<patch-set revision>. Bump
# the suffix whenever patches/, overlay/ or logship/ change. The release tag is
# os-image-v<SEALED_OS_VERSION>.
SEALED_OS_VERSION=0.6.1-s4

# Image names in PlatformRegistry (addImage name) and in release asset names.
SEALED_IMAGE_NAME_PROD=sealed-dstack-os
SEALED_IMAGE_NAME_DEBUG=sealed-dstack-os-debug

# Identity and time of the commits build.sh creates on top of UPSTREAM_COMMIT
# (git am of patches/, then the overlay commit). Fixed, so the patched commit,
# and with it metadata.json, os_image_hash and SOURCE_DATE_EPOCH, is the same
# on every machine.
SEALED_GIT_NAME=sealedtempo
SEALED_GIT_EMAIL=349375820+sealedtempo@users.noreply.github.com
SEALED_GIT_DATE=2026-10-28T00:00:00Z
