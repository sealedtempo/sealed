{{- /*
Sealed Caddyfile template. The composer renders it twice (normal and
payment-needed) and passes both as inline compose configs, so every byte is
covered by stackHash. Values are validated by the composer before rendering.

Gated routes ask sealed-agent first (forward_auth, D-044). The agent answers
200 for a valid sealed_gate cookie or Basic auth as user sealed (and sets the
cookie on a Basic success), 401 with a Basic challenge otherwise, and 503
until the app's bootstrap is done. Its Set-Cookie on a 200 is copied to the
client response. Basic credentials of the gate user are stripped before the
app sees the request: when the agent's 200 carries
X-Sealed-Gate-Strip-Authorization: 1 (it parsed Basic credentials of the
gate user, in whatever form it accepts), and when the header matches the
gate user's Basic prefix; any other Authorization header passes through.
Clients cannot supply either relay header. The
sealed_gate cookie is removed from the Cookie header on every proxied app
request, so no app can replay it against another app's route. Every app
handle body is a route block, because inside a plain handle Caddy runs
same-named directives that have a matcher before those that have none.
*/ -}}
{{- define "cookie_strip_route"}}
			request_header Cookie "(^|;\s*){{.}}=[^;]*" ""
			request_header Cookie "^;\s*" ""
			request_header @sealed_gate_no_cookie -Cookie
{{- end}}
# Generated by the Sealed composer {{.ComposerVersion}}. Measured into stackHash; do not edit.
{{- if .PaymentNeeded}}
# Variant: payment-needed. App routes show the payment-needed page; /attest stays public.
{{- end}}
{
	admin unix/{{.AdminSocket}}|{{.AdminSocketMode}}
	persist_config off
	ocsp_stapling off
	servers {
		protocols h1 h2
	}
}
{{range $site := .Sites}}
{{$site.Host}} {
{{- if $site.Attest}}
	@attest path / /attest
	handle @attest {
		rewrite * /attest?{query}
		reverse_proxy {{$.AttestUpstream}} {
			transport http {
				network_proxy none
			}
		}
	}
{{- end}}
{{- if $.PaymentNeeded}}
{{- if $site.Attest}}
{{- range $r := $site.Routes}}
	@{{$r.ID}} path {{$r.Path}} {{$r.Path}}/*
	handle @{{$r.ID}} {
		respond "{{$.PaymentMessage}}" 402
	}
{{- end}}
	handle {
		respond "Not found" 404
	}
{{- else}}
{{- if $site.HasBearer}}
	@bearer header Authorization "Bearer *"
	handle @bearer {
		respond "{{$.PaymentMessage}}" 402
	}
{{- end}}
	handle {
		root * {{$.PageDir}}
		rewrite * /{{$.PageFile}}
		file_server {
			status 402
		}
	}
{{- end}}
{{- else}}
	@sealed_gate_no_cookie header Cookie ""
{{- if $site.HasGate}}
	@sealed_gate_basic header_regexp Authorization "{{$.GateBasicRegexp}}"
	@sealed_gate_strip header X-Sealed-Gate-Strip-Authorization 1
	@sealed_gate_cookie header X-Sealed-Gate-Set-Cookie *
{{- end}}
{{- range $r := $site.Routes}}
{{- if $r.Path}}
	@{{$r.ID}} path {{$r.Path}} {{$r.Path}}/*
{{- end}}
{{- if eq $r.Auth "bearer-passthrough"}}
	@{{$r.ID}}_bearer {
{{- if $r.Path}}
		path {{$r.Path}} {{$r.Path}}/*
{{- end}}
		header Authorization "Bearer *"
	}
{{- end}}
{{- end}}
{{- range $r := $site.Routes}}
{{- if eq $r.Auth "bearer-passthrough"}}
	handle @{{$r.ID}}_bearer {
		route {
{{- template "cookie_strip_route" $.GateCookie}}
			reverse_proxy {{$r.Upstream}} {
				transport http {
					network_proxy none
				}
			}
		}
	}
{{- end}}
	handle{{if $r.Path}} @{{$r.ID}}{{end}} {
{{- if eq $r.Auth "public"}}
		route {
{{- template "cookie_strip_route" $.GateCookie}}
			reverse_proxy {{$r.Upstream}} {
				transport http {
					network_proxy none
				}
			}
		}
{{- else}}
		route {
			request_header -X-Sealed-Gate-Set-Cookie
			request_header -X-Sealed-Gate-Strip-Authorization
			forward_auth {{$.GateUpstream}} {
				uri {{$.GatePath}}?route={{$r.Name}}
				copy_headers Set-Cookie>X-Sealed-Gate-Set-Cookie X-Sealed-Gate-Strip-Authorization
				transport http {
					network_proxy none
				}
			}
			header @sealed_gate_cookie Set-Cookie {http.request.header.X-Sealed-Gate-Set-Cookie}
			request_header -X-Sealed-Gate-Set-Cookie
			request_header @sealed_gate_strip -Authorization
			request_header -X-Sealed-Gate-Strip-Authorization
			request_header @sealed_gate_basic -Authorization
{{- template "cookie_strip_route" $.GateCookie}}
			reverse_proxy {{$r.Upstream}} {
				transport http {
					network_proxy none
				}
			}
		}
{{- end}}
	}
{{- end}}
{{- if $site.NeedsFallback}}
	handle {
		respond "Not found" 404
	}
{{- end}}
{{- end}}
}
{{end -}}
