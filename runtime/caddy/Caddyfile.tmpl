{{- /*
Sealed Caddyfile template. The composer renders it twice (normal and
payment-needed) and passes both as inline compose configs, so every byte is
covered by stackHash. Values are validated by the composer before rendering.
*/ -}}
# Generated by the Sealed composer {{.ComposerVersion}}. Measured into stackHash; do not edit.
{{- if .PaymentNeeded}}
# Variant: payment-needed. App routes show the payment-needed page; attest stays public.
{{- end}}
{
	admin unix/{{.AdminSocket}}
	persist_config off
	ocsp_stapling off
	servers {
		protocols h1 h2
	}
}
{{range $site := .Sites}}
{{$site.Host}} {
{{- if $.PaymentNeeded}}
{{- if $site.HasBearer}}
	@bearer header Authorization "Bearer *"
	handle @bearer {
		respond "{{$.PaymentMessage}}" 402
	}
{{- end}}
	handle {
		root * {{$.PageDir}}
		rewrite * /{{$.PageFile}}
		file_server {
			status 402
		}
	}
{{- else}}
{{- range $i, $r := $site.Routes}}
{{- if $r.Path}}
	@r{{$i}} path {{$r.Path}} {{$r.Path}}/*
{{- end}}
{{- if eq $r.Auth "bearer-passthrough"}}
	@r{{$i}}_bearer {
{{- if $r.Path}}
		path {{$r.Path}} {{$r.Path}}/*
{{- end}}
		header Authorization "Bearer *"
	}
{{- end}}
{{- end}}
{{- range $i, $r := $site.Routes}}
{{- if eq $r.Auth "bearer-passthrough"}}
	handle @r{{$i}}_bearer {
		reverse_proxy {{$r.Upstream}} {
			transport http {
				network_proxy none
			}
		}
	}
{{- end}}
	handle{{if $r.Path}} @r{{$i}}{{end}} {
{{- if eq $r.Auth "public"}}
		reverse_proxy {{$r.Upstream}} {
			transport http {
				network_proxy none
			}
		}
{{- else}}
		basic_auth {
			{{$.GateUser}} {env.{{$.GateEnv}}}
		}
		reverse_proxy {{$r.Upstream}} {
			header_up -Authorization
			transport http {
				network_proxy none
			}
		}
{{- end}}
	}
{{- end}}
{{- if $site.NeedsFallback}}
	handle {
		respond "Not found" 404
	}
{{- end}}
{{- end}}
}
{{end}}
{{.AttestHost}} {
	@attest path / /attest
	handle @attest {
		rewrite * /attest?{query}
		reverse_proxy {{.AttestUpstream}} {
			transport http {
				network_proxy none
			}
		}
	}
	handle {
		respond "Not found" 404
	}
}
